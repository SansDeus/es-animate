{
  "compilerOptions": {
    "rootDir": "./src/",
    "outDir": "./dist/",
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "strict": true,
    "esModuleInterop": true,
		"declaration": true,
  },
	"include": ["src/**/*"],
  "exclude": [
    "node_modules",
		"dist",
    "test"
  ]
}